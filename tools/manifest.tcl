# Writes manifest.sha256: the SHA-256 of every file the updater installs.
# Run it before tagging a release:   tclsh tools/manifest.tcl
# Check that it is up to date (CI):  tclsh tools/manifest.tcl --check
set root [file normalize [file join [file dirname [info script]] ..]]
source -encoding utf-8 [file join $root modules crypto.tcl]

set files [list service.tcl VERSION LICENSE README.md CHANGELOG.md service.conf.example]
foreach f [lsort [glob -nocomplain -directory [file join $root modules] -tails *.tcl]] { lappend files modules/$f }
foreach f [lsort [glob -nocomplain -directory [file join $root docs] -tails *.md]] { lappend files docs/$f }

set out "# service.tcl release manifest - generated by tools/manifest.tcl\n"
foreach f $files {
	set path [file join $root $f]
	if {![file exists $path]} { puts stderr "missing: $f"; exit 1 }
	append out "[service::crypto::sha256_file $path]  $f\n"
}
set manifest [file join $root manifest.sha256]
if {[lindex $argv 0] eq "--check"} {
	set fh [open $manifest rb]; set current [read $fh]; close $fh
	if {$current ne $out} {
		puts stderr "manifest.sha256 is out of date - run: tclsh tools/manifest.tcl"
		exit 1
	}
	puts "manifest.sha256 is up to date ([llength $files] files)"
} else {
	set fh [open $manifest wb]; puts -nonewline $fh $out; close $fh
	puts "wrote manifest.sha256 ([llength $files] files)"
}
